# Environment Variables Template
# Copy this file to .env and update with your values

# Backend API URL
# IMPORTANT: Choose based on your setup:
#   - Solo dev: Put your ngrok URL directly in .env (and add .env to .gitignore)
#   - Team: Keep generic value here, use .env.local for your personal ngrok URL
#
# Examples:
#   - Emulator/Simulator: http://localhost:3000
#   - Physical device: http://192.168.1.100:3000 (your local IP)
#   - Development with ngrok: https://your-subdomain.ngrok-free.app
#   - Production: https://your-api-domain.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth Client ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth Redirect URI (must match app.json scheme)
EXPO_PUBLIC_OAUTH_REDIRECT_URI=area://oauth

